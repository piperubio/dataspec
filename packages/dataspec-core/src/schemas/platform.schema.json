{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AnalyticsEngine": {
      "description": "Analytics engine configuration.\nRepresents a processing engine for data transformations.",
      "properties": {
        "config": {
          "description": "Engine-specific configuration",
          "type": "object"
        },
        "name": {
          "description": "Unique identifier for the analytics engine",
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/EngineType",
          "description": "Type of analytics engine"
        },
        "version": {
          "description": "Version constraint (e.g., '>=3.0.0')",
          "type": "string"
        }
      },
      "required": ["name", "type"],
      "type": "object"
    },
    "EngineType": {
      "description": "Supported analytics engine types.\nAnalytics engine type values.",
      "enum": ["dbt", "duckdb", "python", "spark"],
      "type": "string"
    },
    "StorageBackend": {
      "description": "Storage backend configuration.\nRepresents a connection to a storage system.",
      "properties": {
        "connection": {
          "description": "Connection string or configuration",
          "type": "string"
        },
        "name": {
          "description": "Unique identifier for the storage backend",
          "type": "string"
        },
        "options": {
          "description": "Additional storage-specific options",
          "type": "object"
        },
        "type": {
          "$ref": "#/definitions/StorageType",
          "description": "Type of storage backend"
        }
      },
      "required": ["name", "type"],
      "type": "object"
    },
    "StorageType": {
      "description": "Supported storage backend types.\nStorage type values.",
      "enum": ["clickhouse", "postgresql", "s3"],
      "type": "string"
    }
  },
  "description": "Platform configuration for data platform resources.\nDefines storage backends and analytics engines available to the platform.",
  "properties": {
    "datahub": {
      "description": "DataHub integration configuration",
      "properties": {
        "gms_url": {
          "description": "DataHub GMS endpoint URL",
          "type": "string"
        },
        "token": {
          "description": "DataHub authentication token (supports env var reference: ${VAR})",
          "type": "string"
        }
      },
      "required": ["gms_url"],
      "type": "object"
    },
    "defaults": {
      "description": "Optional default settings",
      "properties": {
        "storage": {
          "description": "Default storage backend name",
          "type": "string"
        }
      },
      "type": "object"
    },
    "engines": {
      "description": "Array of analytics engines available to the platform",
      "items": {
        "$ref": "#/definitions/AnalyticsEngine"
      },
      "type": "array"
    },
    "storage": {
      "description": "Array of storage backends available to the platform",
      "items": {
        "$ref": "#/definitions/StorageBackend"
      },
      "type": "array"
    }
  },
  "type": "object"
}

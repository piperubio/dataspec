{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ContractReference": {
      "description": "Reference to a contract definition by name and version.",
      "properties": {
        "name": {
          "description": "Name of the contract",
          "type": "string"
        },
        "version": {
          "description": "Version of the contract (semver format)",
          "type": "string"
        }
      },
      "required": ["name", "version"],
      "type": "object"
    },
    "Metadata": {
      "description": "Key-value metadata map for storing arbitrary resource metadata.\nKeys are strings, values can be any JSON-serializable type.",
      "type": "object"
    },
    "SourceEntity": {
      "description": "Represents an entity (table, collection, endpoint, file pattern) within a source.",
      "properties": {
        "contract": {
          "$ref": "#/definitions/ContractReference",
          "description": "Reference to a contract that defines the expected schema for this entity"
        },
        "description": {
          "description": "Human-readable description of the entity",
          "type": "string"
        },
        "entityType": {
          "description": "Type of entity (e.g., 'table', 'collection', 'endpoint', 'file')",
          "type": "string"
        },
        "format": {
          "description": "Data format for file_system entities (e.g., 'parquet', 'csv', 'json')",
          "type": "string"
        },
        "location": {
          "description": "Location identifier for the entity",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/definitions/Metadata",
          "description": "Additional metadata for the entity"
        },
        "method": {
          "description": "HTTP method for API sources (e.g., 'GET', 'POST')",
          "type": "string"
        },
        "name": {
          "description": "The name of the entity",
          "type": "string"
        },
        "partition_by": {
          "description": "Partition columns for file_system entities",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema": {
          "description": "Schema definition if applicable",
          "type": "object"
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "SourceType": {
      "description": "Source type for data ingestion.\nCategorizes where data originates from.",
      "enum": ["api", "database", "file_system", "saas", "streaming"],
      "type": "string"
    }
  },
  "description": "Represents a data source (database, API, file system, streaming, SaaS).\nContains NO connection details - this is definitions-only.",
  "properties": {
    "baseUrl": {
      "description": "Base URL for API and streaming sources",
      "type": "string"
    },
    "entities": {
      "description": "Entities available in this source",
      "items": {
        "$ref": "#/definitions/SourceEntity"
      },
      "type": "array"
    },
    "metadata": {
      "$ref": "#/definitions/Metadata",
      "description": "Metadata associated with the resource"
    },
    "name": {
      "description": "Unique name for the source",
      "type": "string"
    },
    "protocol": {
      "description": "Protocol for API and streaming sources",
      "type": "string"
    },
    "provider": {
      "description": "Provider name for SaaS sources",
      "type": "string"
    },
    "tags": {
      "description": "Tags for categorization and filtering",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "type": {
      "$ref": "#/definitions/SourceType",
      "description": "Type of source"
    }
  },
  "required": ["entities", "name", "type"],
  "type": "object"
}

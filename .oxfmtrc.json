{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "sortImports": {
    "enabled": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "bin/**",
    "coverage/**",
    "*.min.js",
    ".opencode/**"
  ]
}
